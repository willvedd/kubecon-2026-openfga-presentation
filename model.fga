# Example authorization model for accommodateing agents

model
  schema 1.1

type user

type team
  relations
    define member: [user]

type project
  relations
    define can_deploy: [user, team#member]

type service
  relations
    define parent: [project]
    define can_deploy: [user, team#member] or can_deploy from parent

type agent

type tool
  relations
    define can_call: [agent with $expression]